{
  "name": "cms-bdd",
  "version": "1.0.2-dev",
  "description": "Reusable Playwright page objects, components, fixtures, and utilities for testing Drupal and WordPress sites",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/ && prettier --check src/",
    "format": "eslint --fix src/ && prettier --write src/",
    "test": "bddgen && playwright test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "bdd",
    "automation",
    "testing",
    "e2e",
    "framework",
    "page-objects",
    "drupal",
    "wordpress"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-bdd": "^9.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "allure-playwright": "^3.0.0",
    "playwright": "^1.60.0",
    "playwright-bdd": "^9.0.0"
  },
  "dependencies": {
    "dotenv-flow": "^4.1.0"
  },
  "overrides": {
    "uuid": ">=14.0.0"
  }
}
